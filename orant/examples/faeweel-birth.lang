# Birth of Faeweel - The Unified Guardian
# Frames 81-100 from the Faeweel Flipbook Movie

invoke Faeweel as Angel {
  color: "#F8F9FA"
  wings: 6
  flywheel: "spinning"
  glow: bright
}

invoke KickIsland as Island {
  color: "#FF6B35"
  position: "left horizon"
}

invoke JackIsland as Island {
  color: "#4A90E2"
  position: "right horizon"
}

sequence BirthOfAngel {
  duration: 10s

  frame 1 {
    KickIsland appears at (400, 540)
    JackIsland appears at (1520, 540)
  }

  frame 10 {
    Faeweel appears at (960, 540)
    Faeweel fades in
  }

  frame 20 {
    Faeweel glows bright
    emit particles: 50
  }

  frame 30 {
    Faeweel floats gently
  }

  frame 40 {
    KickIsland glows bright
    JackIsland glows bright
  }

  frame 50 {
    emit particles: 30
  }
}

render scene TheBirth {
  background: "cosmic void"
  invoke: BirthOfAngel
  canvas: "1920x1080"
}
