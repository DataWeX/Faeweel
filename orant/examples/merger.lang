  frame 10 {
    Kael moves from (960, 340) to (960, 500)
    Jaren moves from (1160, 440) to (960, 500)
    Solen moves from (1160, 640) to (960, 500)
    Therin moves from (960, 740) to (960, 500)
    Marlowe moves from (760, 640) to (960, 500)
    Cassian moves from (760, 440) to (960, 500)
    Evren moves from (960, 540) to (960, 500)
  }

  frame 20 {
    Kael glows bright
    Jaren glows bright
    Solen glows bright
    Therin glows bright
    Marlowe glows bright
    Cassian glows bright
    Evren glows bright
  }

  frame 30 {
    Kael merges with Evren
    Jaren merges with Evren
    Solen merges with Evren
    Therin merges with Evren
    Marlowe merges with Evren
    Cassian merges with Evren
  }

  frame 40 {
    emit particles: 100
  }
}

render scene TheMerger {
  background: "cosmic void"
  invoke: TheConvergence
  canvas: 1920x1080
}
