{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Orant Lang",
  "scopeName": "source.lang",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#colors"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.lang",
          "match": "#.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.lang",
          "match": "\\b(invoke|as|sequence|frame|render|scene|emit)\\b"
        },
        {
          "name": "keyword.action.lang",
          "match": "\\b(moves|from|to|floats|spins|appears|fades|glows|merges|with)\\b"
        },
        {
          "name": "keyword.modifier.lang",
          "match": "\\b(gently|gradually|clockwise|bright|in|out)\\b"
        },
        {
          "name": "storage.type.lang",
          "match": "\\b(Son|Angel|Island|DataSphere)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.lang",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.lang",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.lang",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.lang",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.lang",
          "match": "\\b\\d+(\\.\\d+)?(s|ms|px)?\\b"
        }
      ]
    },
    "colors": {
      "patterns": [
        {
          "name": "constant.other.color.lang",
          "match": "#[0-9A-Fa-f]{6}\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.lang",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "entity.name.function.lang",
          "match": "\\b[a-z][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
